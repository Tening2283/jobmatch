# --- Django
DJANGO_SECRET_KEY=change-me-with-a-long-random-string
DJANGO_DEBUG=0
DJANGO_ALLOWED_HOSTS=api.example.com,localhost
DJANGO_CSRF_TRUSTED_ORIGINS=https://api.example.com
DJANGO_SECURE_SSL_REDIRECT=0
CORS_ALLOWED_ORIGINS=https://app.example.com

# --- Base de données / Redis
POSTGRES_DB=jobmatch
POSTGRES_USER=jobmatch
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgres://jobmatch:change-me@db:5432/jobmatch
REDIS_URL=redis://redis:6379/0

# --- Matching
# "sentence_transformers" (vrai modèle) ou "fake" (rapide, sans téléchargement de modèle)
EMBEDDER_BACKEND=sentence_transformers
# Dev uniquement : 0 = image sans torch (build bien plus rapide, à combiner avec EMBEDDER_BACKEND=fake)
INSTALL_ML=1
EMBEDDING_MODEL_NAME=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
MATCHING_CANDIDATE_POOL=200

# --- Divers
RESUME_MAX_UPLOAD_MB=5
# Prod derrière nginx : 1 (nginx sert les CV après contrôle d'accès par Django)
RESUME_X_ACCEL_REDIRECT=0
GUNICORN_WORKERS=3
CELERY_CONCURRENCY=2
LOG_LEVEL=INFO
